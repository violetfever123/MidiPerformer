<Project Sdk="Microsoft.NET.Sdk">

  <!--
    内层：实体 + 用例 + 端口。依赖方向朝内 —— 只允许 BCL 和 DryWetMidi，不引用 Avalonia、不碰 Win32。
    靠 TFM 是 net8.0（不是 net8.0-windows）加上下面那份依赖清单强制：框架提供的 Windows API
    在编译期就找不到。手写的 [DllImport] 拦不住（P/Invoke 不需要引用），那靠 review 兜。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MidiPerformer.Core</RootNamespace>
    <AssemblyName>MidiPerformer.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只有 MidiReader / MidiWriter 能用它 -->
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
  </ItemGroup>

</Project>
