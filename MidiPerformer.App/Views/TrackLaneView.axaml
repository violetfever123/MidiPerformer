<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MidiPerformer.App.Views"
             x:Class="MidiPerformer.App.Views.TrackLaneView">
  <!--
    一条轨 = 轨道头 + 卷帘。

    轨道头上是活的：音色（128 个 GM 音色的下拉，鼓轨换成一句说明）、移调（四个步进按钮夹着
    当前值）、改名（名字本身就在那儿，点进去就能改）、删除（两下：先问一句，再删）、折叠、
    抽掉一段（两下：在卷帘上拖出那一段，看明白那一行预览，再抽）。头上每一件都真干活。

    底色 / 边框一律取令牌，这里不出现任何颜色字面值。
  -->
  <UserControl.Styles>
    <!-- wireframe 的 .lhead .stepper：一个圆角框，里面按钮夹着值 -->
    <Style Selector="Border.stepper">
      <Setter Property="Background" Value="{DynamicResource TokenSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 步进按钮：贴着外框，所以自己不要边框、不要圆角，比普通按钮矮一号 -->
    <Style Selector="Button.step">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!--
      中间那个值：左右各一条竖线，把它和按钮分开（wireframe 的 .stepper .val）。
      竖线套在 Border 上 —— TextBlock 没有边框属性。
    -->
    <Style Selector="Border.step-value">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1,0" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.step-value TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      轨头上的小动作按钮（改名 / 删除 / 取消）：比普通按钮小一号、平时不抢眼。
      常驻的删除故意不红 —— 一屏 8 条轨就是 8 个红按钮，播放头红线和选中圈的那点红就淹了。
      红留给「真的要删了」那一步（下面 .danger）。
    -->
    <Style Selector="Button.head-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!--
      hover / pressed 要打在模板的 ContentPresenter 上：Fluent 那些状态直接设在那个元素上，
      绕过了 TemplateBinding，只设 Button 自己的属性盖不住。
    -->
    <Style Selector="Button.head-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenSurface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

    <Style Selector="Button.head-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenSurface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

    <!--
      红色那一步。取 Stop 而不是 Button.danger 的 Warn：Warn 是「注意」，Stop 才是「会没」——
      和演奏窗口的 big-stop 一个色系。类名仍然带 danger。这几条按选择器优先级压过应用级那两条，
      所以悬停不会变成橙色。
    -->
    <Style Selector="Button.head-action.danger">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <!--
      收起来的那一条：wireframe 的 .strip —— 一行「已折叠」加一根压扁的音符条。
      底色跟着轨号奇偶走（和卷帘的 .lane.a / .lane.b 取的是同一对令牌），收起来之后仍然看得出
      是哪条轨。奇偶用 .b 这个类补，Avalonia 的选择器写不出 nth-child。
    -->
    <Style Selector="Border.strip">
      <Setter Property="Background" Value="{DynamicResource TokenLaneA}" />
      <Setter Property="Padding" Value="10,3,10,5" />
    </Style>

    <Style Selector="Border.strip.b">
      <Setter Property="Background" Value="{DynamicResource TokenLaneB}" />
    </Style>

    <Style Selector="Border.strip TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 那根压扁的音符条（wireframe 的 .mini）。圆角走 TokenRadiusSmall —— 圆角一律取令牌，不单开例外。 -->
    <Style Selector="Border.strip-mini">
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusSmall}" />
      <Setter Property="Background" Value="{DynamicResource TokenNote}" />
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!--
      音色下拉（wireframe 的 .lhead select）。应用级那套 ComboBox 样式（见 Controls.axaml）管颜色，
      这里只管轨道头上要的尺寸 —— 轨道头一行里有八九样东西，按默认个头会把这行撑得很高。
    -->
    <Style Selector="ComboBox.timbre">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MaxWidth" Value="150" />
      <Setter Property="MaxDropDownHeight" Value="320" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      聚焦轨的轨道头底色。谁在什么时候换，见 TrackLaneView.SetFocused。

      底色必须写成样式而不是控件上的 Background：Avalonia 里局部值盖得住样式，
      .head.focus 这条会一点效果都没有（和 CSS 的优先级正好相反）。
      两条的先后就是优先级：平时 Surface2，聚焦时整块换成 AccentSoft。
    -->
    <Style Selector="Border.head">
      <Setter Property="Background" Value="{DynamicResource TokenSurface2}" />
    </Style>

    <Style Selector="Border.head.focus">
      <Setter Property="Background" Value="{DynamicResource TokenAccentSoft}" />
    </Style>

    <!-- 就地的改名输入框：和它顶替掉的那行名字同一个字号字重，换上去的时候整行不跳 -->
    <Style Selector="TextBox.rename">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="3,3" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <StackPanel>
    <Border x:Name="Head"
            Classes="head"
            BorderBrush="{DynamicResource TokenLineSoft}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <!--
        列从头到尾：轨号 / 名字 / 音色 / 移调 /（空）/ 删除 / 折叠 / 抽掉一段 / 音数 /（空）。

        第 4 列空着（从前是「改名」按钮），最后一个 `*` 列也空着（从前是独奏那行灰字）。
        列号没跟着往前挪：Auto 的空列宽度是 0，不留痕迹，而底下 CutBar 的 `ColumnSpan="10"`
        和九处 `Grid.Column` 都按十列写的；`*` 列把余下的宽度全吃掉，画出来和没有这一列一样。

        名字那一格的两个控件占同一列，同一时刻只亮一个 —— 改名是就地换的，不另开一格，
        否则一按改名整行会横向错位一下。第二行是「抽掉一段」那一问（见下面 CutBar），
        平时整行是塌的，所以这一格平时就是一行高。
      -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowDefinitions="Auto,Auto">
        <TextBlock x:Name="NumberText"
                   Grid.Column="0"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource TokenInkFaint}"
                   MinWidth="20" VerticalAlignment="Center" />
        <!--
          NameText 恒隐，但它装着这条轨此刻该显示的那个名字 —— 没名字的轨是兜底的「轨 01」
          （见 DisplayName）。CommitRename 拿它当基准比（用户看不出区别的改动不该提交），
          Bind 是算这个名字的唯一地方，两个控件一起刷。给人看的是这一格常驻的那个输入框。
        -->
        <TextBlock x:Name="NameText"
                   Grid.Column="1"
                   IsVisible="False"
                   FontSize="12.5" FontWeight="SemiBold"
                   MinWidth="62" VerticalAlignment="Center" />
        <!--
          名字框常驻：轨名点进去就能改，和工具栏那颗 SongNameBox 同一个样子。
          回车确定、Esc 取消、焦点走了算数。
        -->
        <TextBox x:Name="NameBox"
                 Grid.Column="1"
                 Classes="rename"
                 KeyDown="OnNameBoxKeyDown"
                 GotFocus="OnNameBoxGotFocus"
                 LostFocus="OnNameBoxLostFocus"
                 ToolTip.Tip="改这条轨的名字（回车确定，Esc 取消）" />
        <!--
          音色那一格：旋律轨是一个 128 项的 GM 下拉，鼓轨是一句不能点的说明（9 号声道整条都是
          鼓组，音色号在它上面没有意义）。两样二选一，谁亮见 TrackLaneView.Bind。
        -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <StackPanel x:Name="TimbrePicker" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource TokenInkMuted}"
                       VerticalAlignment="Center" Text="音色" />
            <ComboBox x:Name="TimbreBox"
                      Classes="timbre"
                      SelectionChanged="OnTimbreChanged"
                      ToolTip.Tip="换这条轨试听用的音色（发给游戏时永远是口琴那套键位）" />
          </StackPanel>
          <TextBlock x:Name="TimbreText"
                     FontSize="11.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     IsVisible="False"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock FontSize="12.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     VerticalAlignment="Center" Text="移调" />
          <!--
            四个步进：±1 半音、±12（一个八度）。移调是绝对赋值，按钮只负责把「当前值 ± n」
            算出来，交给命令去设。Tag 里是 ASCII 减号（要被 int.Parse 读），按钮上写的是
            排版用的减号 U+2212 —— 两个字符不一样是有意的。
          -->
          <Border Classes="stepper">
            <StackPanel Orientation="Horizontal">
              <Button Classes="step" Content="−12" Tag="-12" Click="OnTransposeStepClick"
                      ToolTip.Tip="低一个八度" />
              <Button Classes="step" Content="−1" Tag="-1" Click="OnTransposeStepClick"
                      ToolTip.Tip="低一个半音" />
              <Border Classes="step-value">
                <TextBlock x:Name="TransposeText" Classes="mono" />
              </Border>
              <Button Classes="step" Content="+1" Tag="1" Click="OnTransposeStepClick"
                      ToolTip.Tip="高一个半音" />
              <Button Classes="step" Content="+12" Tag="12" Click="OnTransposeStepClick"
                      ToolTip.Tip="高一个八度" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 删除那一格：平时只有一个按钮；按下去换成一句「删掉这条轨？」+ 删除 / 取消 -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                    Margin="6,0,0,0" VerticalAlignment="Center">
          <Button x:Name="DeleteButton"
                  Classes="head-action"
                  Content="删除"
                  Click="OnDeleteClick"
                  ToolTip.Tip="删掉这条轨（会先问一句，可以撤销）" />
          <StackPanel x:Name="DeleteConfirm" Orientation="Horizontal" Spacing="6"
                      IsVisible="False" VerticalAlignment="Center">
            <TextBlock Text="删掉这条轨？"
                       FontSize="11.5"
                       Foreground="{DynamicResource TokenStop}"
                       VerticalAlignment="Center" />
            <Button x:Name="DeleteYesButton"
                    Classes="head-action danger"
                    Content="删除"
                    Click="OnDeleteConfirmClick"
                    ToolTip.Tip="真的删掉（Ctrl+Z 可以撤销）" />
            <Button x:Name="DeleteCancelButton"
                    Classes="head-action"
                    Content="取消"
                    Click="OnDeleteCancelClick"
                    ToolTip.Tip="不删了" />
          </StackPanel>
        </StackPanel>

        <!--
          折叠 / 展开。一个按钮两句话：它说的是同一条轨的同一个开关，按内容的字面意思走
          （wireframe 里那句 `this.textContent = now ? "折叠" : "展开"`）。
          提示里那句「试听时不出声」是必须写的 —— 折叠现在不只是看不见，还听不见。
        -->
        <Button x:Name="FoldButton"
                Grid.Column="6"
                Classes="head-action"
                Margin="6,0,0,0"
                Content="折叠"
                Click="OnFoldClick"
                ToolTip.Tip="把这条轨收成一行，试听时不再出声（谱面一个字节都不动）" />

        <!--
          抽掉一段。和删除一样是两下：按下去在轨道头的第二行换出一排「抽掉」/「取消」+ 一行预览。
          要抽掉的那一段在卷帘上直接拖出来，所以提示里得说清「拖」（见 Format.CutNeedRange）。

          提示里还必须说清它改的是时间轴：别的编辑只动音高、时值、名字，抽掉之后这条轨后半截
          整体提前，和别的轨永久错位。
        -->
        <Button x:Name="CutButton"
                Grid.Column="7"
                Classes="head-action"
                Margin="6,0,0,0"
                Content="抽掉一段…"
                Click="OnCutClick"
                ToolTip.Tip="把这条轨上的一段连时间一起抽走、后面的音自动接上来（不是只把音符擦掉）。按下去之后到卷帘上横向拖出那一段（吸附到十六分格），再按「抽掉」。只动这条轨，别的轨原地不动 —— Ctrl+Z 可以撤销" />

        <TextBlock x:Name="CountText"
                   Grid.Column="8"
                   FontSize="11.5"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TokenInkMuted}"
                   VerticalAlignment="Center" />

        <!--
          抽掉一段那一问。摆在轨道头的第二行里 —— 它问的是这条轨的事，就该长在这条轨的头上；
          而且轨道头的底色（含聚焦那一笔）连着它一起变，「现在弄的是哪条轨」一眼看得出来。

          这一问没有输入框：要抽掉的那一段在卷帘上直接拖出来，所以这一行只剩「说明 + 两颗按钮」。
          右边那行预览是这一步的重点（见 TrackLaneView.UpdateCutSummary）：按下「抽掉」之前，
          屏幕上得有一句话说出哪几个音会没、后面多少音会提前、这条轨短几小节。
        -->
        <Grid x:Name="CutBar"
              Grid.Row="1" Grid.ColumnSpan="10"
              IsVisible="False"
              Margin="0,6,0,0"
              ColumnDefinitions="Auto,*">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="CutYesButton"
                    Classes="head-action danger"
                    Content="抽掉"
                    IsEnabled="False"
                    Click="OnCutConfirmClick"
                    ToolTip.Tip="真的抽掉（Ctrl+Z 可以撤销）" />
            <Button x:Name="CutCancelButton"
                    Classes="head-action"
                    Content="取消"
                    Click="OnCutCancelClick"
                    ToolTip.Tip="不抽了（Esc 同效）" />
          </StackPanel>

          <TextBlock x:Name="CutSummary"
                     Grid.Column="1"
                     Margin="14,0,0,0"
                     FontSize="11.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Border>

    <views:PianoRollLane x:Name="Roll" />

    <!--
      收起来时顶替卷帘的那一行。谁在什么时候亮，见 TrackLaneView.SetCollapsed。
      「不发声」三个字是齐着折叠一起加的 —— 这一行是屏幕上唯一说得出这件事的地方。
    -->
    <Border x:Name="Strip" Classes="strip" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="已折叠 · 不发声" />
        <Border Grid.Column="1" Classes="strip-mini" />
      </Grid>
    </Border>
  </StackPanel>

  <!--
    聚焦轨左边那一根竖条。谁在什么时候亮，见 TrackLaneView.SetFocused。

    必须是一个盖在整条轨上面的独立元素：给整个 lane 加一圈内描边是不行的 —— 里面每一层
    （轨道头的 Border、卷帘的底色）都是不透明的、铺满整块，描边画在它们底下看不见。

    压在上面就得让指针穿过去（IsHitTestVisible="False"）：它盖住的是卷帘最左边 3px，
    不放行的话那一小条上的按下拖不动、点不中。

    贴着左边缘、不撑开内容：撑开的话卷帘的宽度会随「是不是聚焦」变一下，整条谱会左右跳。
  -->
  <Border x:Name="FocusBar"
          Width="3"
          HorizontalAlignment="Left"
          Background="{DynamicResource TokenAccent}"
          IsVisible="False"
          IsHitTestVisible="False" />
  </Panel>
</UserControl>
