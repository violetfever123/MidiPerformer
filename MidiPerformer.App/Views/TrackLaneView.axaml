<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MidiPerformer.App.Views"
             x:Class="MidiPerformer.App.Views.TrackLaneView">
  <!--
    一条轨 = 轨道头 + 卷帘。

    轨道头上是活的：**音色**（128 个 GM 音色的下拉，鼓轨换成一句说明）、**移调**
    （四个步进按钮夹着当前值）、**改名**（名字本身就在那儿，点进去就能改）、
    **删除**（两下：先问一句，再删）、**折叠**、
    **抽掉一段**（两下：填两个小节号，看明白那一行预览，再抽）。
    还没做、也还没有归属切片的只剩「只看这条」，所以右边那行灰字如实写着它 ——
    摆一排按了没反应的控件比不摆更坏，人会以为是自己没点对。

    底色 / 边框一律取令牌，这里不出现任何颜色字面值。
  -->
  <UserControl.Styles>
    <!-- wireframe 的 .lhead .stepper：一个圆角框，里面按钮夹着值 -->
    <Style Selector="Border.stepper">
      <Setter Property="Background" Value="{DynamicResource TokenSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 步进按钮：贴着外框，所以自己不要边框、不要圆角，比普通按钮矮一号 -->
    <Style Selector="Button.step">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!--
      中间那个值：左右各一条竖线，把它和按钮分开（wireframe 的 .stepper .val）。
      竖线套在 Border 上而不是文字上 —— Avalonia 的 TextBlock 没有边框属性。
    -->
    <Style Selector="Border.step-value">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1,0" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.step-value TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      轨头上的小动作按钮（改名 / 删除 / 取消）：比普通按钮小一号、平时不抢眼。
      常驻的删除**故意不红**：一屏有 8 条轨，8 个红按钮压在那里，播放头红线和选中圈的
      那点红就淹了。红留给「真的要删了」那一步（下面 .danger），那才是不可逆的那一下。
    -->
    <Style Selector="Button.head-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!--
      hover / pressed 要打在模板的 ContentPresenter 上：Fluent 那些状态是**直接设在那个元素上**的，
      绕过了 TemplateBinding，只设 Button 自己的属性盖不住。这几条能生效，是因为控件自己的
      Styles 排在 Application.Styles 之后 —— Controls.axaml 开头解释了这件事。
    -->
    <Style Selector="Button.head-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenSurface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

    <Style Selector="Button.head-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenSurface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

    <!--
      红色那一步。取 Stop 而不是 Controls.axaml 里 Button.danger 的 Warn：
      Warn 是「注意」（试听、风险提示那种），Stop 才是「会没」——
      和演奏窗口的 big-stop 一个色系。类名仍然带 danger（意思一样），
      这几条按选择器优先级压过应用级那两条，所以悬停不会变成橙色。
    -->
    <Style Selector="Button.head-action.danger">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <Style Selector="Button.head-action.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <!--
      收起来的那一条：wireframe 的 .strip —— 一行「已折叠」加一根压扁的音符条。
      底色跟着轨号奇偶走（和卷帘的 .lane.a / .lane.b 取的是同一对令牌），
      收起来之后那一条仍然看得出是哪条轨。奇偶用 .b 这个类补，Avalonia 的选择器写不出 nth-child。
    -->
    <Style Selector="Border.strip">
      <Setter Property="Background" Value="{DynamicResource TokenLaneA}" />
      <Setter Property="Padding" Value="10,3,10,5" />
    </Style>

    <Style Selector="Border.strip.b">
      <Setter Property="Background" Value="{DynamicResource TokenLaneB}" />
    </Style>

    <Style Selector="Border.strip TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      那根压扁的条：wireframe 的 .mini（height:9px、opacity:.45）。
      取 TokenRadiusSmall 而不是 wireframe 写的 2px —— 圆角一律走令牌，这一处不单开一个例外。
    -->
    <Style Selector="Border.strip-mini">
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusSmall}" />
      <Setter Property="Background" Value="{DynamicResource TokenNote}" />
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!--
      音色下拉：wireframe 的 .lhead select（11.5px、圆角 4px、最宽 150px）。
      应用级那套 ComboBox 样式（见 Controls.axaml）管颜色，这里只管轨道头上要的尺寸 ——
      轨道头一行里有八九样东西，按控件默认那套的个头会把这行撑得很高。
    -->
    <Style Selector="ComboBox.timbre">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MaxWidth" Value="150" />
      <Setter Property="MaxDropDownHeight" Value="320" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      聚焦轨的轨道头底色。谁在什么时候换，见 TrackLaneView.SetFocused。

      底色**必须**写成样式而不是控件上的 Background="…"：Avalonia 里局部值盖得住样式，
      .head.focus 这条会一点效果都没有 —— 和 CSS 里那套优先级正好相反，
      这一处是照 wireframe 抄过来时最容易带错的地方。

      两条的先后就是优先级（同一条 Styles 里后写的赢，和上面 .strip / .strip.b 一样）：
      平时是 Surface2，聚焦时整块换成 AccentSoft。
    -->
    <Style Selector="Border.head">
      <Setter Property="Background" Value="{DynamicResource TokenSurface2}" />
    </Style>

    <Style Selector="Border.head.focus">
      <Setter Property="Background" Value="{DynamicResource TokenAccentSoft}" />
    </Style>

    <!-- 就地的改名输入框：和它顶替掉的那行名字同一个字号字重，换上去的时候整行不跳 -->
    <Style Selector="TextBox.rename">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="3,3" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      抽掉一段那两个小节号框。窄、居中、数字等宽 —— 一格里最多四位，宽度按「四位数字」定死，
      框不会随着输进去几个字左右抽动。
    -->
    <Style Selector="TextBox.barno">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MaxLength" Value="4" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <StackPanel>
    <Border x:Name="Head"
            Classes="head"
            BorderBrush="{DynamicResource TokenLineSoft}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <!--
        列从头到尾：轨号 / 名字 / 音色 / 移调 / **（空）** / 删除 / 折叠 / 抽掉一段 / 音数 / 右边那行灰字。

        第 4 列空着：那儿从前是「改名」按钮，25 号工单把改名做成「名字本身可编辑」之后按钮就没了。
        列号**没跟着往前挪**（挪一列要动九处 Grid.Column，而 Auto 的空列宽度是 0，不留痕迹），
        所以后面那几列的号比它们的实际位置大一号。

        名字那一格的两个控件占同一列（也占满那一列），同一时刻只亮一个 ——
        改名是**就地**换的，不另开一格，否则一按改名整行会横向错位一下。

        第二行是「抽掉一段」那一问（见下面的 CutBar），平时整行是塌的（IsVisible=False 的
        子元素不占高度），所以这一格平时就是一行高。
      -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowDefinitions="Auto,Auto">
        <TextBlock x:Name="NumberText"
                   Grid.Column="0"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource TokenInkFaint}"
                   MinWidth="20" VerticalAlignment="Center" />
        <!--
          NameText 恒隐，但它不是废控件：它装着这条轨**此刻该显示的那个名字** ——
          没名字的轨是兜底的「轨 01」（见 DisplayName）。CommitRename 拿它当基准比
          （用户看不出区别的改动不该提交：框里写着「轨 01」时按回车，不该把这三个字
          写成真名字），Bind 是算这个名字的唯一地方，两个控件一起刷。

          为什么不删掉它、把那份名字挪进一个字段：那只是把「看不见」换个地方放，
          还要多回答一次「这个字段谁来维护」；留成控件就和别的显示一起在 Bind 里刷完了。
          它自己不显示：这一格常驻的那个输入框才是给人看的那个。
        -->
        <TextBlock x:Name="NameText"
                   Grid.Column="1"
                   IsVisible="False"
                   FontSize="12.5" FontWeight="SemiBold"
                   MinWidth="62" VerticalAlignment="Center" />
        <!--
          名字框**常驻**：轨名不再需要先点一下「改名」（25 号工单删掉了那颗按钮），
          名字本身就在这儿、点进去就能改 —— 和工具栏那颗 SongNameBox 同一个样子
          （它本来就是这套做法的样板）。回车确定、Esc 取消、焦点走了算数，三条都没变。
        -->
        <TextBox x:Name="NameBox"
                 Grid.Column="1"
                 Classes="rename"
                 KeyDown="OnNameBoxKeyDown"
                 GotFocus="OnNameBoxGotFocus"
                 LostFocus="OnNameBoxLostFocus"
                 ToolTip.Tip="改这条轨的名字（回车确定，Esc 取消）" />
        <!--
          音色那一格：旋律轨是一个 128 项的 GM 下拉，鼓轨是一句不能点的说明
          （9 号声道整条都是鼓组，音色号在它上面没有意义 —— 摆一个改了也不知道会怎样的
          下拉，比明说「这是鼓组」坏）。两样二选一，谁亮见 TrackLaneView.Bind。
        -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <StackPanel x:Name="TimbrePicker" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource TokenInkMuted}"
                       VerticalAlignment="Center" Text="音色" />
            <ComboBox x:Name="TimbreBox"
                      Classes="timbre"
                      SelectionChanged="OnTimbreChanged"
                      ToolTip.Tip="换这条轨试听用的音色（发给游戏时永远是口琴那套键位）" />
          </StackPanel>
          <TextBlock x:Name="TimbreText"
                     FontSize="11.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     IsVisible="False"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock FontSize="12.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     VerticalAlignment="Center" Text="移调" />
          <!--
            四个步进：±1 半音、±12（一个八度）。移调是**绝对赋值**，
            按钮只负责把「当前值 ± n」算出来，交给命令去设。
            Tag 里是 ASCII 减号（要被 int.Parse 读），按钮上写的是排版用的减号 U+2212 ——
            两个字符不一样是有意的。
          -->
          <Border Classes="stepper">
            <StackPanel Orientation="Horizontal">
              <Button Classes="step" Content="−12" Tag="-12" Click="OnTransposeStepClick"
                      ToolTip.Tip="低一个八度" />
              <Button Classes="step" Content="−1" Tag="-1" Click="OnTransposeStepClick"
                      ToolTip.Tip="低一个半音" />
              <Border Classes="step-value">
                <TextBlock x:Name="TransposeText" Classes="mono" />
              </Border>
              <Button Classes="step" Content="+1" Tag="1" Click="OnTransposeStepClick"
                      ToolTip.Tip="高一个半音" />
              <Button Classes="step" Content="+12" Tag="12" Click="OnTransposeStepClick"
                      ToolTip.Tip="高一个八度" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 删除那一格：平时只有一个按钮；按下去换成一句「删掉这条轨？」+ 删除 / 取消 -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                    Margin="6,0,0,0" VerticalAlignment="Center">
          <Button x:Name="DeleteButton"
                  Classes="head-action"
                  Content="删除"
                  Click="OnDeleteClick"
                  ToolTip.Tip="删掉这条轨（会先问一句，可以撤销）" />
          <StackPanel x:Name="DeleteConfirm" Orientation="Horizontal" Spacing="6"
                      IsVisible="False" VerticalAlignment="Center">
            <TextBlock Text="删掉这条轨？"
                       FontSize="11.5"
                       Foreground="{DynamicResource TokenStop}"
                       VerticalAlignment="Center" />
            <Button x:Name="DeleteYesButton"
                    Classes="head-action danger"
                    Content="删除"
                    Click="OnDeleteConfirmClick"
                    ToolTip.Tip="真的删掉（Ctrl+Z 可以撤销）" />
            <Button x:Name="DeleteCancelButton"
                    Classes="head-action"
                    Content="取消"
                    Click="OnDeleteCancelClick"
                    ToolTip.Tip="不删了" />
          </StackPanel>
        </StackPanel>

        <!--
          折叠 / 展开。**一个按钮两句话**，不是两个按钮：它说的是同一条轨的同一个开关，
          按内容的字面意思走（wireframe 里那句 `this.textContent = now ? "折叠" : "展开"`）。

          提示里那句「试听时不出声」是**必须写的**：收起一条轨现在不只是看不见，还听不见，
          而屏幕上除了那一行小字没有任何东西会说这件事。
        -->
        <Button x:Name="FoldButton"
                Grid.Column="6"
                Classes="head-action"
                Margin="6,0,0,0"
                Content="折叠"
                Click="OnFoldClick"
                ToolTip.Tip="把这条轨收成一行，试听时不再出声（谱面一个字节都不动）" />

        <!--
          抽掉一段。和删除一样是**两下**：按下去在轨道头的第二行换出一排
          「抽掉第 __ 小节 到 第 __ 小节」，填好、看明白那一行预览，再按「抽掉」才算数。

          这一下和别的编辑不是一回事，提示里必须说清：它改的是**时间轴**，
          别的编辑只动音高、时值、名字，抽掉之后这条轨后半截整体提前，
          和别的轨永久错位 —— 这是功能的定义，但用户不一定会往这儿想。
        -->
        <Button x:Name="CutButton"
                Grid.Column="7"
                Classes="head-action"
                Margin="6,0,0,0"
                Content="抽掉一段…"
                Click="OnCutClick"
                ToolTip.Tip="把这条轨上某几小节连时间一起抽走、后面的音自动接上来（不是只把音符擦掉）。只动这条轨，别的轨原地不动 —— Ctrl+Z 可以撤销" />

        <TextBlock x:Name="CountText"
                   Grid.Column="8"
                   FontSize="11.5"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TokenInkMuted}"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="LaterText"
                   Grid.Column="9"
                   FontSize="11"
                   Foreground="{DynamicResource TokenInkFaint}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!--
          抽掉一段那一问。摆在轨道头的**第二行**里 —— 不弹对话框，也不在卷帘上另开一条：
          它问的是这条轨的事，就该长在这条轨的头上；而且轨道头的底色（含聚焦那一笔）
          连着它一起变，「现在填的是哪条轨」一眼看得出来 —— 填错轨是这一步最容易犯的错。

          右边那一行预览是这一步的重点（见 TrackLaneView.UpdateCutSummary）：
          按下「抽掉」之前，屏幕上得有一句话说出哪几个音会没、后面多少音会提前、这条轨短几小节。
        -->
        <Grid x:Name="CutBar"
              Grid.Row="1" Grid.ColumnSpan="10"
              IsVisible="False"
              Margin="0,6,0,0"
              ColumnDefinitions="Auto,Auto,*">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="抽掉第"
                       FontSize="11.5"
                       Foreground="{DynamicResource TokenInk}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CutFromBox"
                     Classes="barno"
                     TextChanged="OnCutBarChanged"
                     KeyDown="OnCutBoxKeyDown"
                     LostFocus="OnCutBoxLostFocus"
                     ToolTip.Tip="从第几小节（这一小节也算在内）。超出曲子范围会夹到首尾，填反了会自动换过来" />
            <TextBlock Text="小节 到 第"
                       FontSize="11.5"
                       Foreground="{DynamicResource TokenInk}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CutToBox"
                     Classes="barno"
                     TextChanged="OnCutBarChanged"
                     KeyDown="OnCutBoxKeyDown"
                     LostFocus="OnCutBoxLostFocus"
                     ToolTip.Tip="到第几小节（这一小节也算在内）" />
            <TextBlock Text="小节"
                       FontSize="11.5"
                       Foreground="{DynamicResource TokenInk}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      Margin="12,0,0,0" VerticalAlignment="Center">
            <Button x:Name="CutYesButton"
                    Classes="head-action danger"
                    Content="抽掉"
                    IsEnabled="False"
                    Click="OnCutConfirmClick"
                    ToolTip.Tip="真的抽掉（Ctrl+Z 可以撤销）" />
            <Button x:Name="CutCancelButton"
                    Classes="head-action"
                    Content="取消"
                    Click="OnCutCancelClick"
                    ToolTip.Tip="不抽了（Esc 同效）" />
          </StackPanel>

          <TextBlock x:Name="CutSummary"
                     Grid.Column="2"
                     Margin="14,0,0,0"
                     FontSize="11.5"
                     Foreground="{DynamicResource TokenInkMuted}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Border>

    <views:PianoRollLane x:Name="Roll" />

    <!--
      收起来时顶替卷帘的那一行。谁在什么时候亮，见 TrackLaneView.SetCollapsed。

      「不发声」三个字是齐着 wireframe 那一行加的（wireframe 里只写「已折叠」）：
      折叠现在连试听一起关掉，而这一行是屏幕上唯一说得出这件事的地方。
    -->
    <Border x:Name="Strip" Classes="strip" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="已折叠 · 不发声" />
        <Border Grid.Column="1" Classes="strip-mini" />
      </Grid>
    </Border>
  </StackPanel>

  <!--
    聚焦轨左边那一根竖条。谁在什么时候亮，见 TrackLaneView.SetFocused。

    **必须是一个盖在整条轨上面的独立元素。** 这一条是踩过的坑：
    给整个 lane 加一圈「内描边」是不行的 —— 里面每一层（轨道头的 Border、卷帘的底色）
    都是**不透明的、铺满整块**的，描边画在它们底下，一个像素都看不见。
    在 CSS 里同一个坑长成 `box-shadow: inset`；在 Avalonia 里长成「给外层 Border 加背景色」。
    所以这里画的是一根真的竖条，摆在最后 = 压在所有东西上面。

    压在上面就得**让指针穿过去**（IsHitTestVisible="False"）：它盖住的是卷帘最左边 3px，
    不放行的话那一小条上的按下拖不动、点不中，而屏幕上没有任何东西说得清为什么。

    贴着左边缘、不撑开内容：撑开的话卷帘的宽度会随「是不是聚焦」变一下，
    一屏几个小节的换算跟着变，整条谱会左右跳一下。
  -->
  <Border x:Name="FocusBar"
          Width="3"
          HorizontalAlignment="Left"
          Background="{DynamicResource TokenAccent}"
          IsVisible="False"
          IsHitTestVisible="False" />
  </Panel>
</UserControl>
