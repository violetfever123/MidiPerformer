<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MidiPerformer.App.Views"
             x:Class="MidiPerformer.App.Views.SongLibraryPanel">
  <!--
    歌曲库：一份列表，住在 SongLibraryWindow 里。

    这个文件只管「长什么样」，窗口只管「摆在哪、多大」。列表的行是代码建的
    （曲名 + 改过没改过 + 删除），见 SongLibraryPanel.axaml.cs。

    两块：标题（「歌曲库」+「N 首」）、列表。「N 首」是这份列表唯一的汇总读数。
    底色 / 边框 / 每一行的 hover 与选中态全部取令牌。列表用 ListBox —— 选中态、
    键盘上下键、滚动都不用自己再实现一遍；它自己的底色和边框在这儿被按掉（面板底下已经
    是毛玻璃，再套一个同色的框只会多出一圈线）。

    底子是一层毛玻璃（F5）：糊掉的背景 + 45% 底色 + 颗粒 + 顶边高光，见 FrostedGlassLayer。
    这一层在**内容后面**，所以上面这些字、行、按钮一个都不用改 —— 它们只是从「一块实色板」
    变成了「一块玻璃板」。
  -->
  <UserControl.Styles>
    <!--
      一行的曲名：占满剩下的宽度，名字太长就省略号（wireframe 的 .song .nm）。

      Background 取透明是为了让这一格真的能被鼠标碰到：不设底色的 TextBlock 只在字身上接得到
      鼠标，而这一格要悬停出 ToolTip（看被省略号吃掉的完整曲名）。
      Cursor 是默认箭头而不是 IBeam：点它只是选中这一行、双击打开这一首，不是「这儿可以打字」。
    -->
    <Style Selector="TextBlock.song-name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 曲名右边那格小字（wireframe 的 .song .mt 那个位置）：那儿画的是时长，这儿画「改过 / 没动过」。 -->
    <Style Selector="TextBlock.song-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 读不出来的那份：换成 warn 色 -->
    <Style Selector="TextBlock.song-meta.bad">
      <Setter Property="Foreground" Value="{DynamicResource TokenWarn}" />
    </Style>

    <!--
      行里剩下的那一个小动作（删除）。改名只剩顶栏「歌曲名」那一格。
      删除一直在、只是很淡（wireframe 里是悬停才显形）：平时看不见的按钮写错了也没人会
      发现，而它到底是没了还是只是没悬停，看的人也分不出来。
    -->
    <Style Selector="Button.row-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
    </Style>

    <!-- 删除那一颗：字号大一号当 × 用，颜色交给 Controls.axaml 的 Button.danger（悬停时变 warn 色）。 -->
    <Style Selector="Button.row-action.del">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="5,0" />
    </Style>

    <!-- 空曲库那一句，摆在列表正中 -->
    <Style Selector="TextBlock.empty-hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!--
      底子：毛玻璃（F5）。它摆得跟面板一样大、垫在最下面，位图比面板大 90px 一圈（多出来的被它自己剪掉）。

      原来那个 surface-2 的 Border 撤了：底色现在由这一层出（45% 的 TokenSurface）——
      留着那块实色就会把玻璃整个盖住，那这一票就白做了。右边那道 1px 竖线更早以前就撤了
      （搬进窗口之后右边没有邻居）。
    -->
    <views:FrostedGlassLayer x:Name="Glass" />

    <Grid RowDefinitions="Auto,*">

      <!-- ==================== 标题：「歌曲库」+「N 首」 ==================== -->
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource TokenLineSoft}"
              BorderThickness="0,0,0,1"
              Padding="12,9,12,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="歌曲库"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TokenInkFaint}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="CountText"
                     FontSize="11"
                     Foreground="{DynamicResource TokenInkFaint}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ==================== 列表 ==================== -->
      <Panel Grid.Row="1">
        <ListBox x:Name="SongList"
                 Background="Transparent"
                 BorderThickness="0"
                 CornerRadius="0"
                 Padding="6"
                 KeyDown="OnListKeyDown" />
        <TextBlock x:Name="EmptyHint" Classes="empty-hint" IsVisible="False"
                   Text="还没有曲子" />
      </Panel>
    </Grid>
  </Panel>
</UserControl>
