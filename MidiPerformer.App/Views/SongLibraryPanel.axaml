<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MidiPerformer.App.Views.SongLibraryPanel">
  <!--
    歌曲库：左边那一条（docs/wireframe.html 的 <aside class="lib">）。

    三块里的两块：标题（「歌曲库」+ 几首）、列表。原来底下还有一句脚注
    （「导入的曲子存进这个文件夹…」），这条切片把它删了 —— 曲库在哪儿、改名就是改文件名，
    都是用户点一次「导入」就明白的事，不必常年占着两行。列表的行是**代码建的**
    （曲名 + 改过没改过 + 删除），见 SongLibraryPanel.axaml.cs ——
    房子住在这儿，家具在那边按曲库里的内容摆。

    底色 / 边框 / 每一行的 hover 与选中态，全部取令牌，这里没有一个颜色字面值。
    列表用的是 ListBox：Controls.axaml 里那两条 ListBoxItem 规则（透明边框 + hover 换
    surface-3 + 选中 accent-soft / accent-line / 加粗）就是照着 wireframe 的 .song 写的，
    选中态、键盘上下键、滚动都不用自己再实现一遍。

    列表自己的底色和边框在这儿被按掉（wireframe 的 .songlist 是一张白纸，不是个框）——
    面板已经是 surface-2 了，再套一个同色的框只会多出一圈线。
  -->
  <UserControl.Styles>
    <!--
      一行的曲名：占满剩下的宽度，名字太长就省略号（wireframe 的 .song .nm）。

      Background 取透明是**为了让这一格真的能被鼠标碰到**：不设底色的 TextBlock 只在字身上
      接得到鼠标，而这一格要一件事 —— 悬停出 ToolTip（看被省略号吃掉的完整曲名）。
      透明底把整格都变成它的地盘，鼠标落在「字与字之间的空隙」里也能看见提示，
      而不是只有指到笔画上才弹。

      **Cursor 是默认箭头，不是 IBeam**（32 号工单改回来的）：这一格从前点一下就进改名，
      于是光标做成 IBeam 承诺「这儿可以打字」。现在点它只是选中这一行、双击打开这一首，
      IBeam 就成了空头支票 —— 光标形状是这一格唯一还会说话的地方，不能让它说谎。
    -->
    <Style Selector="TextBlock.song-name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      曲名右边那格小字（wireframe 的 .song .mt 那个位置）。
      那儿画的是时长，这儿画「改过 / 没动过」—— 见 .axaml.cs 里的说明。
    -->
    <Style Selector="TextBlock.song-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 读不出来的那份：这一格换成 warn 色，一眼看得出这份工程有问题 -->
    <Style Selector="TextBlock.song-meta.bad">
      <Setter Property="Foreground" Value="{DynamicResource TokenWarn}" />
    </Style>

    <!--
      行里剩下的那一个小动作（删除）。改名既不是一颗按钮、也不在行里 ——
      32 号之后它只剩顶栏「歌曲名」那一格（改的是当前开着的那首），这个列表里
      点名字只是选中、双击打开。

      wireframe 里删除是**悬停才显形**的（.song .del{opacity:0}），这里改成**一直在、
      只是很淡**：这条切片没有能自动点一遍界面的测试，一个平时看不见的按钮，
      写错了也没人会发现（它是真的没了还是只是没悬停？）。淡色的代价是列表看着热闹一点，
      换成「按钮其实不在」的代价更大。
    -->
    <Style Selector="Button.row-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
    </Style>

    <!--
      删除那一颗：字号大一号当 × 用，颜色交给 Controls.axaml 的 Button.danger
      （类名在代码里加，就是那条「危险：删轨 / 删曲子」）—— 悬停时变 warn 色，
      和 wireframe 的 .song .del:hover 一个意思，不在这儿再抄一遍。
    -->
    <Style Selector="Button.row-action.del">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="5,0" />
    </Style>

    <!-- 空曲库那一句，摆在列表正中 -->
    <Style Selector="TextBlock.empty-hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource TokenSurface2}"
          BorderBrush="{DynamicResource TokenLine}"
          BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*">

      <!-- ==================== 标题：「歌曲库」+「N 首」 ==================== -->
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource TokenLineSoft}"
              BorderThickness="0,0,0,1"
              Padding="12,9,12,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="歌曲库"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TokenInkFaint}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="CountText"
                     FontSize="11"
                     Foreground="{DynamicResource TokenInkFaint}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ==================== 列表 ==================== -->
      <Panel Grid.Row="1">
        <ListBox x:Name="SongList"
                 Background="Transparent"
                 BorderThickness="0"
                 CornerRadius="0"
                 Padding="6"
                 KeyDown="OnListKeyDown" />
        <TextBlock x:Name="EmptyHint" Classes="empty-hint" IsVisible="False"
                   Text="还没有曲子" />
      </Panel>
    </Grid>
  </Border>
</UserControl>
