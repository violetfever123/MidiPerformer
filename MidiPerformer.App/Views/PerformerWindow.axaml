<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiPerformer.App.Views.PerformerWindow"
        Title="演奏器"
        Width="430" SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TokenSurface}">

  <!--
    窗口二 · 演奏器（docs/wireframe.html 里那一块）。

    和编辑器的窗口是两件事：这个窗口**置顶**，因为演奏时要切到游戏里去，
    切回来只是为了急停 —— 置顶能让它一直露在游戏画面上面。

    窗口本身就是 wireframe 里的 .perf 那张卡片（surface 底 + 细边 + 圆角 + 阴影），
    所以这里只设窗口底色，外面不再套一层 Border。

    从前这儿还有一块**常驻风险提示**（`Border.risk`：虚拟输入违反游戏规则、可能导致封号、风险自负），
    27 号工单把它删了 —— **有意接受的代价**：它是自用工具上唯一一句风险提示，
    不影响任何功能，但以后给别人用就没这句话了。
    留下的那条「为什么没开始」的通道是**状态行**（见下面 StatusText 那一段，文案在
    `Format.PreflightRefusal`）：它说的是**这一按为什么没生效、下一步去改什么**，
    那块横幅说的是**用这个程序的后果**，两件事 —— 删的是后者。

    05 补上的是「演奏轨」那一行的筛选（只列单声部轨），以及一条可弹的都没有时的空状态块；
    06 补上的是倒计时与基准八度两行、预检失败的中文提示，以及按下开始之后那块
    **浮在游戏画面上**的悬浮层 —— 悬浮层是另一个窗口，见 PerformerOverlayWindow。
    「目标窗口」那一行要等 13 的实机验证，现在摆一个选了也不生效的下拉框比不摆更坏。
  -->

  <Window.Styles>

    <!-- ==================== 排版 ==================== -->
    <!-- wireframe 的 .prow：一行「标签 + 值」。标签定宽，几行左边就对齐了 -->
    <Style Selector="TextBlock.row-label">
      <Setter Property="Width" Value="74" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.row-value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- wireframe 的 .phint：缩进到与值齐，说明下一行的「为什么只有这些」 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="84,0,0,0" />
    </Style>

    <!-- ==================== 启动 / 急停 ==================== -->
    <!-- wireframe 的 .big：占满一行、字大一号，闭着眼睛也点得中 -->
    <Style Selector="Button.big">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!--
      下面每一条都写了 Button 自己和它的 ContentPresenter 两层：
      hover / pressed / disabled 是 Fluent 直接设在模板里的 ContentPresenter 上的，
      只设 Button 的属性盖不住（Controls.axaml 的开头解释了这件事）。
    -->
    <Style Selector="Button.big-start">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <!-- 前景取 TokenSurface 而不是 wireframe 的白：暗色下 accent 是浅蓝，压白字读不清 -->
      <Setter Property="Foreground" Value="{DynamicResource TokenSurface}" />
    </Style>
    <Style Selector="Button.big-start /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenSurface}" />
    </Style>
    <Style Selector="Button.big-start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccentLine}" />
    </Style>
    <Style Selector="Button.big-start:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccentLine}" />
    </Style>

    <Style Selector="Button.big-stop">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
    </Style>

    <!--
      禁用态排在**每一条**按钮类规则之后：同优先级的 setter 谁后写谁赢，
      排在前面就会被 .big-start 的 setter 盖回去，没有曲子的时候「开始」看着还能点。
      （Controls.axaml 里那条管不到这里 —— 窗口自己的样式优先级更高。）
    -->
    <Style Selector="Button.big:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
    </Style>

    <!-- ==================== 状态行 ==================== -->
    <!-- wireframe 的 .status：一枚小圆点 + 一句话。圆点的颜色就是「在什么状态」 -->
    <Style Selector="Border.status">
      <Setter Property="Background" Value="{DynamicResource TokenSurface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLineSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusButton}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.dot">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dot.ready">
      <Setter Property="Foreground" Value="{DynamicResource TokenAccent}" />
    </Style>
    <Style Selector="TextBlock.dot.run">
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <!-- ==================== 小按钮 ==================== -->
    <!--
      wireframe 的 .mini-btn：比普通按钮小一号、字色淡一档，
      用在「值」那一行和下面那块空状态说明里 —— 它是陪衬，不该跟「开始演奏」抢眼睛。
    -->
    <Style Selector="Button.mini">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!-- ==================== 空状态 ==================== -->
    <!--
      wireframe 的 .emptybox：一条能弹的轨都没有时顶上提示行的那块说明。

      用**警告**色系而不是报错的红：用户没做错什么，只是这首曲子不适合口琴。
      红色会让人以为程序坏了，而这里要说的是「换一首或者去删声部」。
    -->
    <Style Selector="Border.emptybox">
      <Setter Property="Background" Value="{DynamicResource TokenWarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenWarnLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusPanel}" />
      <Setter Property="Padding" Value="11,10" />
    </Style>
    <Style Selector="Border.emptybox TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 结论那句要比解释显眼：用户扫一眼就该知道发生了什么（这一条排在通用规则之后） -->
    <Style Selector="Border.emptybox TextBlock.title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

  </Window.Styles>

  <StackPanel Margin="14" Spacing="11">

    <!-- ============ 曲目 ============ -->
    <Grid ColumnDefinitions="74,*,Auto" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="曲目" />
      <TextBlock Grid.Column="1" Classes="row-value" x:Name="SongValue" Text="还没有选曲子" />
      <Button Grid.Column="2" x:Name="OpenButton" Content="打开 MIDI…" Click="OnOpenMidi" />
    </Grid>

    <!-- ============ 演奏轨 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="演奏轨" />
      <ComboBox Grid.Column="1" x:Name="TrackCombo" HorizontalAlignment="Stretch"
                PlaceholderText="先打开一首 MIDI" IsEnabled="False" />
    </Grid>
    <!--
      提示行：wireframe 的「只列出单声部轨 · 4 条轨里 2 条可演奏」。
      两个数取自两个地方 —— N 是这首曲子一共几条轨（song.Tracks.Count），
      M 是其中能弹的（TrackRanking.Of 的结果条数）。不另算一遍「可弹数」：
      那样下拉框里几条、提示里几个数就有了两个真相源，迟早对不上。
    -->
    <TextBlock Classes="hint" x:Name="TrackHint" Text="只列出单声部轨。" />

    <!--
      空状态：一条能弹的都没有。这一块**顶掉**上面那行提示（意思是一回事，
      没必要两行都说），并把下拉框锁死、开始按钮变灰 —— 能按的都按不动，
      比让用户按下去了再听漏音好。wireframe 的空状态卡片里正是这个摆法。
    -->
    <Border Classes="emptybox" x:Name="EmptyBox" IsVisible="False">
      <StackPanel Spacing="7">
        <TextBlock Classes="title" Text="这首歌没有可演奏的单声部轨。" />
        <TextBlock>
          <Run Text="游戏乐器同时只能响一个音，多声部轨发出去会糊成一片，所以不列出来。" /><LineBreak />
          <Run Text="回编辑器里删掉多余声部，或者换一首。" />
        </TextBlock>
        <Button Classes="mini" x:Name="GoEditorButton" Content="去编辑器…"
                HorizontalAlignment="Left" Click="OnGoEditor" />
      </StackPanel>
    </Border>

    <!-- ============ 时序档位 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="时序" />
      <ComboBox Grid.Column="1" x:Name="TimingCombo" HorizontalAlignment="Stretch" SelectedIndex="1" />
    </Grid>
    <TextBlock Classes="hint" x:Name="TimingHint"
               Text="游戏按键按帧采样，间隔给不够会漏音。不确定就用标准档。" />

    <!-- ============ 基准八度 ============ -->
    <!--
      口琴只有三个八度：基准八度、上下各一个，外加最高两个音。基准选错，
      超出去的音会被整段跳过（卷帘上标灰），所以「自动」是按音域选的那个。
    -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="基准八度" />
      <ComboBox Grid.Column="1" x:Name="BaseOctaveCombo" HorizontalAlignment="Stretch" SelectedIndex="0" />
    </Grid>
    <TextBlock Classes="hint" x:Name="BaseOctaveHint"
               Text="自动 = 让可演奏区容下最多音符；手动指定就按你选的那个八度算。" />

    <!-- ============ 倒计时 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="倒计时" />
      <ComboBox Grid.Column="1" x:Name="CountdownCombo" HorizontalAlignment="Stretch" SelectedIndex="0" />
    </Grid>
    <TextBlock Classes="hint" x:Name="CountdownHint"
               Text="按下开始之后用它切到游戏窗口。倒计时结束才发第一个音，期间按 F6 取消。" />

    <Border Classes="rule" />

    <!-- ============ 开始 / 急停 ============ -->
    <Button x:Name="StartButton" Classes="big big-start" Click="OnStart" IsEnabled="False">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="▶ 开始演奏" VerticalAlignment="Center" />
        <!-- 急停键写在按钮上：演奏前就该知道出事了按哪个键 -->
        <TextBlock Text="F6 急停" FontSize="11" FontWeight="Normal" Opacity="0.8"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Button x:Name="StopButton" Classes="big big-stop" Content="■ 急停"
            Click="OnStop" IsEnabled="False" />

    <!-- ============ 状态 ============ -->
    <!--
      **这一行是「为什么没开始」的唯一通道。** 预检不放行时它说的是三种失败里具体哪一种、
      下一步去改什么（文案在 Format.PreflightRefusal，不在这个文件里）。
      从前它下面还有一块常驻风险横幅，27 号工单删掉了 —— 两件事不一样：
      横幅说的是用这个程序的后果，这一行说的是这一按为什么没生效。
    -->
    <Border Classes="status">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="StatusDot" Classes="dot" Text="●" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="就绪 · 先打开一首 MIDI" />
      </StackPanel>
    </Border>

  </StackPanel>
</Window>
