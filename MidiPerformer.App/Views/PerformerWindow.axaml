<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiPerformer.App.Views.PerformerWindow"
        Title="演奏器"
        Width="430" SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TokenSurface}">

  <!--
    窗口二 · 演奏器（docs/wireframe.html 里那一块）。

    这个窗口置顶：演奏时要切到游戏里去，切回来只是为了急停，置顶能让它一直露在游戏画面上面。
    窗口本身就是 wireframe 的 .perf 那张卡片（surface 底 + 细边 + 圆角 + 阴影），
    所以这里只设窗口底色，外面不再套一层 Border。

    按下开始之后那块浮在游戏画面上的悬浮层是另一个窗口，见 PerformerOverlayWindow。
    「目标窗口」那一行要等实机验证，摆一个选了也不生效的下拉框比不摆更坏。
  -->

  <Window.Styles>

    <!-- ==================== 排版 ==================== -->
    <!-- wireframe 的 .prow：一行「标签 + 值」。标签定宽，几行左边就对齐了 -->
    <Style Selector="TextBlock.row-label">
      <Setter Property="Width" Value="74" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.row-value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- wireframe 的 .phint：缩进到与值齐，说明下一行的「为什么只有这些」 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="84,0,0,0" />
    </Style>

    <!-- ==================== 启动 / 急停 ==================== -->
    <!-- wireframe 的 .big：占满一行、字大一号，闭着眼睛也点得中 -->
    <Style Selector="Button.big">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!--
      下面每一条都写了 Button 自己和它的 ContentPresenter 两层：hover / pressed / disabled
      是 Fluent 直接设在模板里的 ContentPresenter 上的，只设 Button 的属性盖不住。
    -->
    <Style Selector="Button.big-start">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <!-- 前景取 TokenSurface 而不是 wireframe 的白：暗色下 accent 是浅蓝，压白字读不清 -->
      <Setter Property="Foreground" Value="{DynamicResource TokenSurface}" />
    </Style>
    <Style Selector="Button.big-start /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenSurface}" />
    </Style>
    <Style Selector="Button.big-start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccentLine}" />
    </Style>
    <Style Selector="Button.big-start:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TokenAccentLine}" />
    </Style>

    <Style Selector="Button.big-stop">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStopLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
    </Style>
    <Style Selector="Button.big-stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenStopSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenStop}" />
    </Style>

    <!--
      禁用态排在每一条按钮类规则之后：同优先级的 setter 谁后写谁赢，排在前面就会被 .big-start
      盖回去，没有曲子的时候「开始」看着还能点。（Controls.axaml 里那条管不到这里 ——
      窗口自己的样式优先级更高。）
    -->
    <Style Selector="Button.big:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
    </Style>

    <!-- ==================== 状态行 ==================== -->
    <!-- wireframe 的 .status：一枚小圆点 + 一句话。圆点的颜色就是「在什么状态」 -->
    <Style Selector="Border.status">
      <Setter Property="Background" Value="{DynamicResource TokenSurface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLineSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusButton}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.dot">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dot.ready">
      <Setter Property="Foreground" Value="{DynamicResource TokenAccent}" />
    </Style>
    <Style Selector="TextBlock.dot.run">
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
    </Style>

    <!-- ==================== 小按钮 ==================== -->
    <!--
      wireframe 的 .mini-btn：比普通按钮小一号、字色淡一档，用在「值」那一行和空状态说明里 ——
      它是陪衬，不该跟「开始演奏」抢眼睛。
    -->
    <Style Selector="Button.mini">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!-- ==================== 空状态 ==================== -->
    <!--
      wireframe 的 .emptybox：一条能弹的轨都没有时顶上提示行的那块说明。
      用警告色系而不是报错的红 —— 用户没做错什么，只是这首曲子不适合口琴。
    -->
    <Style Selector="Border.emptybox">
      <Setter Property="Background" Value="{DynamicResource TokenWarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenWarnLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusPanel}" />
      <Setter Property="Padding" Value="11,10" />
    </Style>
    <Style Selector="Border.emptybox TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 结论那句要比解释显眼（这一条排在通用规则之后） -->
    <Style Selector="Border.emptybox TextBlock.title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
    </Style>

    <!-- ==================== 音域读数（38 根细条） ==================== -->
    <!--
      一根细条 = 一个半音。底色是「这格没用到」，亮起来是「这首歌用到了」——
      所以条子的根数本身就是「半音也看得见」这条要求的答案。

      **全部同高（24px），这是硬要求**：病根是嵌套布局默认的 stretch ——
      里面只要有一根比别人高，它所在的**那一段整体**会被撑起来，那一段看着就比别的段高一截。
      所以段容器一律显式 Height=24 + VerticalAlignment=Bottom，细条也一律 Bottom，
      而状态**只换底色 / 不透明度 / 描边，一根都不用高度分档**。
    -->
    <Style Selector="Border.s38">
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{DynamicResource TokenSurface3}" />
      <Setter Property="CornerRadius" Value="2" />
      <!--
        右边那道 2px 的缝用外边距做（原型里是 border-right + background-clip:padding-box）：
        这样每根的布局盒子宽度正好是 1 个单位，四段的 12:12:12:2 才真的等于 12:12:12:2。
        段容器上**不许加 Spacing**（等于 CSS 的 gap）—— 12 根的那段缝多，每根会偏窄一点点。
      -->
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <!-- 升号音（黑键）只降不透明度：一根细条只剩 8px 的肉，再换底色或描边就糊成一团 -->
    <Style Selector="Border.s38.sharp">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- 亮着 = 这首歌用到的音。排在 .sharp 之后：升号音又亮又黑键时，亮的那一档说了算 -->
    <Style Selector="Border.s38.lit">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      正在响的那一根：**跟别人一样高**，只在同一高度上套一圈细边。
      原型那边这一圈是 box-shadow 画的（1.5px 的 TokenInk，不带模糊）。
      Avalonia 的 BoxShadow 只吃字面色、接不了令牌，所以改用同一个盒子里的内描边画这一圈 TokenInk。
      内描边（不是外描边）才不改盒子尺寸 —— 改一点点宽度，四段就不等宽了。
    -->
    <Style Selector="Border.s38.now">
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenInk}" />
    </Style>

    <!--
      越界：亮着的一律变红。灰的那些保持灰 ——
      红的是「这首歌现在弹不出来」这个状态，不是「所有音都错了」，把没用到的也涂红只会淹掉信号。
      排在 .lit 之后：同优先级的 setter 谁后写谁赢。
    -->
    <Style Selector="Grid.bad Border.s38.lit">
      <Setter Property="Background" Value="{DynamicResource TokenStop}" />
    </Style>

    <!-- 段头那四个音名（C3 / C4 / C5 / C6）用等宽字：它们要对齐各段左端 -->
    <Style Selector="TextBlock.k38">
      <Setter Property="FontFamily" Value="{DynamicResource TokenFontMono}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 常态读数行。加粗的那几段是强调（用到的音数 / 平移量 / 正在响的音），见 PitchRangeReadout.SummarySlots -->
    <Style Selector="TextBlock.sum38">
      <Setter Property="Margin" Value="0,7,0,0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 越界那一声：居中、红、大一档。副行退回去当陪衬 -->
    <Style Selector="TextBlock.alert38">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenStop}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.alert-sub38">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== 按键速度（平均 + 峰值 + 每秒直方图） ==================== -->
    <!--
      两个数：峰值那个数**重一档**（大一号 + 加粗 + warn 色），平均是陪衬（小一号 + 常规 + 淡一档）。
      重一档不能只靠颜色 —— 同一块色在浅底 / 暗底上轻重会翻个个儿，而字号和字重到哪儿都是那个差
      （brief §5s：颜色只能判「大块纯色、边界干净」的东西）。峰值那个数是 warn、峰值那根柱子是 stop：
      前者照原型（K1 的两个数），后者照规格（「红的那一秒」，直方图那一条）。
    -->
    <Style Selector="TextBlock.kps">
      <Setter Property="FontFamily" Value="{DynamicResource TokenFontMono}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.kps.peak">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TokenWarn}" />
    </Style>
    <Style Selector="TextBlock.kps-unit">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.kps-sep">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TokenLine}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- 横轴那行字：左端 0:00 / 中间那句 / 右端总时长，三条一样淡，落在直方图底下 -->
    <Style Selector="TextBlock.kps-axis">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkFaint}" />
    </Style>

    <!--
      直方图一根柱子 = 一秒。**底对齐**、等高线由 KeyRateView 按读数给的 Height 说了算
      （根数随曲子变，所以柱子不在 XAML 里摆）。
    -->
    <Style Selector="Border.kbar">
      <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
      <Setter Property="CornerRadius" Value="1,1,0,0" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- 峰值那一秒变红。排在 .kbar 之后：同优先级的 setter 谁后写谁赢 -->
    <Style Selector="Border.kbar.peak">
      <Setter Property="Background" Value="{DynamicResource TokenStop}" />
    </Style>

    <!-- ==================== 微调（±1 半音） ==================== -->
    <!--
      形状照抄轨编辑器那个移调步进器（TrackLaneView.axaml 的 Border.stepper / Button.step /
      Border.step-value）：同样的圆角框、同样的透明步进键、同样的中间那格 ——
      两个窗口里认的是同一个东西。档位只给 ±1：八度一级的偏差由打开曲子时算出来的基准八度解决，
      而且算完就钉住（原型 S1/S2：「抄形状，不抄 ±12 那两格」）。
      （那格在编辑器里是只读的 Border.step-value，形状照抄，但它是**按键** —— 见下面那一段。）
    -->
    <Style Selector="Border.stepper">
      <Setter Property="Background" Value="{DynamicResource TokenSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusControl}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 步进按钮：贴着外框，所以自己不要边框、不要圆角，比普通按钮矮一号 -->
    <Style Selector="Button.step">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
      <!-- 三颗等宽：选中那颗要重一档字重，不定宽的话它一粗就把中间那格挤窄一点 -->
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInkMuted}" />
    </Style>

    <!--
      中间那格 0：左右各一条竖线把它和按钮分开（编辑器里是 Border.step-value 干的）。
      这儿它是**按键**不是只读的值格 —— 「0」也是一个要能选回来的档位，所以竖线直接画在按钮上。

      ⚠️ 除了宽度和这两条竖线，**别的什么都不许加**：字体 / 高度 / 内外边距一动，三颗的盒子尺寸就不一样了。
      实机量到过——给这格加过 TokenFontMono（等宽字的行高和默认字体不一样），中间那颗就成了 36 px 高、顶边低 2 px，
      另两颗 40 px（「三颗一样高、顶边一格不差」当场不过）。编辑器那个值格本来也没用等宽字，
      所以去掉它既是修盒子，也是更贴「抄形状」。
    -->
    <Style Selector="Button.step.mid">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="BorderBrush" Value="{DynamicResource TokenLine}" />
      <Setter Property="BorderThickness" Value="1,0" />
    </Style>

    <!--
      选中的那一档。取别的控件「选中」用的那一套（ListBoxItem:selected：accent-soft 底 + 重一档字重），
      不另发明一种选中态。只换底色 / 字重，不换边框粗细 —— 一改边框宽度，三颗的盒子尺寸就变了。
      排在 .step 之后（同优先级谁后写谁赢），而且比它多一个类。
    -->
    <Style Selector="Button.step.on">
      <Setter Property="Background" Value="{DynamicResource TokenAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource TokenInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

  </Window.Styles>

  <StackPanel Margin="14" Spacing="11">

    <!-- ============ 演奏轨 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="演奏轨" />
      <!--
        占位文字说的是「这会儿还没曲子」这个**瞬时态**，不是一条操作指引 ——
        这个窗口里没有打开 MIDI 的路（「曲目」行连同那颗文件选择器已经按界面改版删掉了），
        写成「先打开一首 MIDI」就是一句**办不到的话**。曲子由外面经 LoadSong 递进来，
        到时候这行占位换成「选一条轨」/「— 无可演奏的轨 —」（见 ApplySong）。
      -->
      <ComboBox Grid.Column="1" x:Name="TrackCombo" HorizontalAlignment="Stretch"
                PlaceholderText="还没拿到曲子" IsEnabled="False" />
    </Grid>
    <!--
      提示行：wireframe 的「只列出单声部轨 · 4 条轨里 2 条可演奏」。两个数取自两个地方 ——
      N 是这首曲子一共几条轨（song.Tracks.Count），M 是其中能弹的（PlayableTracks.Of 的结果条数）。
      不另算一遍「可弹数」，那样下拉框里几条、提示里几个数就有了两个真相源。
    -->
    <TextBlock Classes="hint" x:Name="TrackHint" Text="只列出单声部轨。" />

    <!--
      空状态：一条能弹的都没有。这一块顶掉上面那行提示（意思是一回事），并把下拉框锁死、
      开始按钮变灰 —— 能按的都按不动，比让用户按下去了再听漏音好。
    -->
    <Border Classes="emptybox" x:Name="EmptyBox" IsVisible="False">
      <StackPanel Spacing="7">
        <TextBlock Classes="title" Text="这首歌没有可演奏的单声部轨。" />
        <TextBlock>
          <Run Text="游戏乐器同时只能响一个音，多声部轨发出去会糊成一片，所以不列出来。" /><LineBreak />
          <Run Text="回编辑器里删掉多余声部，或者换一首。" />
        </TextBlock>
        <Button Classes="mini" x:Name="GoEditorButton" Content="去编辑器…"
                HorizontalAlignment="Left" Click="OnGoEditor" />
      </StackPanel>
    </Border>

    <!-- ============ 按键速度（平均 + 峰值 + 每秒直方图） ============ -->
    <!--
      紧贴「演奏轨」那一行、挂在它底下（不另起一行、不单独成块）：选完轨第一个想知道的就是
      「这首弹得动吗」，这条直方图是它的细节。
      三个数**全部在播放之前算完**（用户的原话：不想在播放的时候临时看）—— 载入就看得见，
      不用先按播放，演奏期间一个数都不动。它们从 EventBuilder.Build 那张事件表来，
      和真按下去的是同一张表（KeyRateReadout 那一半是纯函数，另有测试盯着）。

      直方图缩进 84px，与上面那一行的「值」左端齐（74 的标签列 + 10 的列距）。
      一秒一根柱子：峰值那一秒 TokenStop，其余 TokenAccent —— 颜色只标「哪一秒是峰值」，
      柱子的高矮由 Height 给（brief §5s：颜色当不了几何判据）。
      整块没得画时（没曲子 / 一条能弹的轨都没有）不出现，见 KeyRateView.Show。
    -->
    <StackPanel x:Name="KeyRate" IsVisible="False" Margin="0,3,0,0">

      <!--
        读数那一行：标签 + 两个数。峰值那个数**重一档**（大一号 + 加粗 + warn 色），
        平均是陪衬 —— 难不难不在平均值，在最密的那一秒。
      -->
      <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Classes="row-label" Text="按键速度" />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="5" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" x:Name="KeyRateAverage" Classes="kps" Text="" />
          <TextBlock Grid.Column="1" Classes="kps-unit" Text="平均" />
          <TextBlock Grid.Column="2" Classes="kps-sep" Text="·" />
          <TextBlock Grid.Column="3" x:Name="KeyRatePeak" Classes="kps peak" Text="" />
          <TextBlock Grid.Column="4" Classes="kps-unit" Text="峰值 键/秒" />
        </Grid>
      </Grid>

      <!--
        每秒直方图：缩进 84px 挂在上面那一行的值底下。柱子那一格是**空的** ——
        一秒一根、根数随曲子变，全由 KeyRateView 摆（XAML 里摆不出来，摆了它也会当场抛）。
      -->
      <StackPanel Margin="84,0,0,0">
        <UniformGrid x:Name="KeyRateBars" Rows="1" Height="26" Margin="0,5,0,0" />

        <!--
          横轴：左端 0:00、右端总时长、中间那句「整曲每秒按键数 · 红的那一秒是峰值」。
          三处字都由 KeyRateReadout 写（连 0:00 也是，走同一个时钟格式），这儿不写样例 ——
          写一份样例就多一个真相源。
        -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3,0,0">
          <TextBlock Grid.Column="0" x:Name="KeyRateAxisStart" Classes="kps-axis" Text="" />
          <TextBlock Grid.Column="1" x:Name="KeyRateAxisNote" Classes="kps-axis" Text=""
                     HorizontalAlignment="Center" />
          <TextBlock Grid.Column="2" x:Name="KeyRateAxisEnd" Classes="kps-axis" Text="" />
        </Grid>
      </StackPanel>

    </StackPanel>

    <!-- ============ 微调（±1 半音） ============ -->
    <!--
      位置是**钉死的**：在「按键速度」下面、38 根细条正上面，中间不插任何东西 ——
      这两块是一个东西的两半（一挪挪的是整首歌，条子整片跟着挪一根），
      隔开一行的话，微调一动，眼睛还得往下跳一段才看得见图变了（原型 S3 / W1 ③）。

      三颗按钮 = 三个档位（−1 / 0 / +1），默认选 0。中间那颗是「值格」的样子 ——
      形状照抄轨编辑器那个步进器，所以两个窗口里认的是同一个东西。

      「一档一个半音，挪的是整首歌，窗口不动」是**代码**保证的：
      这个值不写回 track.Transpose（演奏器是「放」的，不是「改」的），
      而是化作 StartPerformanceRequest.TransposeOffset 进事件表 —— 条子上亮的那几格和真按下去的
      那几格因此还是同一张表；而窗口（基准八度）在载入时就算定、算完钉住，微调一动不动它。
    -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="微调" />
      <Border Grid.Column="1" Classes="stepper" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <!--
            Tag 里是 ASCII 减号（要被 int.Parse 读），按钮上写的是排版用的减号 U+2212 ——
            和编辑器那几颗一样，两个字符不一样是有意的。
          -->
          <Button x:Name="FineMinus" Classes="step" Content="−1" Tag="-1"
                  Click="OnFineTune" ToolTip.Tip="整首歌低一个半音" />
          <Button x:Name="FineZero" Classes="step mid" Content="0" Tag="0"
                  Click="OnFineTune" ToolTip.Tip="不微调" />
          <Button x:Name="FinePlus" Classes="step" Content="+1" Tag="1"
                  Click="OnFineTune" ToolTip.Tip="整首歌高一个半音" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ 音域读数（38 根细条） ============ -->
    <!--
      这一块横跨整行、不缩进 84px：原型里 .p38 就是 .pwin 的直接子元素，和 .prow 平级。
      位置在「微调」下面、中间不插任何东西（这两块是一个东西的两半：挪半音，条子整片跟着挪一根）。

      四段 = 手上四段：前三段各 12 个半音（低八度 / 基准八度 / 高八度），
      尾巴两个是「右键 + 逗号」（B+2 的 do 和 #do）—— 12:12:12:2 这个比例是格子的权重给的，
      不是拿眼睛配的。中间那三个 8px 是**独立空列**，不是 Spacing：Spacing 会让 12 根的那段
      每根偏窄一点点，四段就不一样宽了。

      条子上的状态全在 PitchRangeView.Show 里按算法刷（哪些亮、哪根套边、越界变红），
      这里只摆骨架：38 根全暗、段头写 C3/C4/C5/C6、读数行不出现（还没曲子，读数是这首歌的量）。
    -->
    <StackPanel x:Name="PitchRange" Margin="0,3,0,0">

      <!-- 38 根细条。段容器的格子定义与下面那行音名**必须一模一样**，音名才落在各段左端 -->
      <Grid x:Name="RangeBar" ColumnDefinitions="12*,8,12*,8,12*,8,2*" Height="24">

        <Grid Grid.Column="0" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
              Height="24" VerticalAlignment="Bottom">
          <Border Grid.Column="0" Classes="s38" />
          <Border Grid.Column="1" Classes="s38" />
          <Border Grid.Column="2" Classes="s38" />
          <Border Grid.Column="3" Classes="s38" />
          <Border Grid.Column="4" Classes="s38" />
          <Border Grid.Column="5" Classes="s38" />
          <Border Grid.Column="6" Classes="s38" />
          <Border Grid.Column="7" Classes="s38" />
          <Border Grid.Column="8" Classes="s38" />
          <Border Grid.Column="9" Classes="s38" />
          <Border Grid.Column="10" Classes="s38" />
          <Border Grid.Column="11" Classes="s38" />
        </Grid>

        <Grid Grid.Column="2" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
              Height="24" VerticalAlignment="Bottom">
          <Border Grid.Column="0" Classes="s38" />
          <Border Grid.Column="1" Classes="s38" />
          <Border Grid.Column="2" Classes="s38" />
          <Border Grid.Column="3" Classes="s38" />
          <Border Grid.Column="4" Classes="s38" />
          <Border Grid.Column="5" Classes="s38" />
          <Border Grid.Column="6" Classes="s38" />
          <Border Grid.Column="7" Classes="s38" />
          <Border Grid.Column="8" Classes="s38" />
          <Border Grid.Column="9" Classes="s38" />
          <Border Grid.Column="10" Classes="s38" />
          <Border Grid.Column="11" Classes="s38" />
        </Grid>

        <Grid Grid.Column="4" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
              Height="24" VerticalAlignment="Bottom">
          <Border Grid.Column="0" Classes="s38" />
          <Border Grid.Column="1" Classes="s38" />
          <Border Grid.Column="2" Classes="s38" />
          <Border Grid.Column="3" Classes="s38" />
          <Border Grid.Column="4" Classes="s38" />
          <Border Grid.Column="5" Classes="s38" />
          <Border Grid.Column="6" Classes="s38" />
          <Border Grid.Column="7" Classes="s38" />
          <Border Grid.Column="8" Classes="s38" />
          <Border Grid.Column="9" Classes="s38" />
          <Border Grid.Column="10" Classes="s38" />
          <Border Grid.Column="11" Classes="s38" />
        </Grid>

        <!-- 尾巴两个音：只有两根细条宽，音名写不下，所以下面那行的字从右端往左长 -->
        <Grid Grid.Column="6" ColumnDefinitions="*,*" Height="24" VerticalAlignment="Bottom">
          <Border Grid.Column="0" Classes="s38" />
          <Border Grid.Column="1" Classes="s38" />
        </Grid>

      </Grid>

      <!-- 段头那行：只写段头那个音名，手位（按住左键 / 不按 / 右键 / 右键+逗号）不在界面上重复 -->
      <Grid x:Name="RangeKeys" ColumnDefinitions="12*,8,12*,8,12*,8,2*" Margin="0,5,0,0">
        <TextBlock Grid.Column="0" x:Name="RangeKey0" Classes="k38" Text="C3" />
        <TextBlock Grid.Column="2" x:Name="RangeKey1" Classes="k38" Text="C4" />
        <TextBlock Grid.Column="4" x:Name="RangeKey2" Classes="k38" Text="C5" />
        <TextBlock Grid.Column="6" x:Name="RangeKey3" Classes="k38" Text="C6"
                   HorizontalAlignment="Right" />
      </Grid>

      <!--
        常态读数行：十个槽一字排开，槽 1 / 4 / 8 是强调段（加粗 + 强调色）。
        槽的位置是**契约**：PitchRangeView 按顺序把这十个写进去，PitchRangeReadout.SummarySlots
        按同样的顺序产出，缺一个就在构造函数里抛。所以这十个 <Run> 必须**挨着写、中间不留空白** ——
        换行留白会多出几个只有空格的 Run，槽就对不上了。它们的 Text 一开始都是空的（等于不出现）。
      -->
      <TextBlock x:Name="RangeSummary" Classes="sum38" IsVisible="False"><Run Text="" /><Run Text="" Foreground="{DynamicResource TokenAccent}" FontWeight="SemiBold" /><Run Text="" /><Run Text="" /><Run Text="" Foreground="{DynamicResource TokenAccent}" FontWeight="SemiBold" /><Run Text="" /><Run Text="" /><Run Text="" /><Run Text="" Foreground="{DynamicResource TokenAccent}" FontWeight="SemiBold" /><Run Text="" /></TextBlock>

      <!--
        越界那一声：常态读数行**换掉**成这一组（互斥，不是并列）。两行字都由代码写
        （PitchRangeReadout.AlertTitle / AlertSub）—— 这儿不写样例，免得多出一个真相源。
      -->
      <StackPanel x:Name="RangeAlert" IsVisible="False" Margin="0,8,0,0" Spacing="3">
        <TextBlock x:Name="RangeAlertTitle" Classes="alert38" Text="" />
        <TextBlock x:Name="RangeAlertSub" Classes="alert-sub38" Text="" />
      </StackPanel>

    </StackPanel>

    <!-- ============ 时序档位 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="时序" />
      <ComboBox Grid.Column="1" x:Name="TimingCombo" HorizontalAlignment="Stretch" SelectedIndex="1" />
    </Grid>
    <!-- 措辞照规格图（docs/spec-界面改版.md 的「演奏器 —— 组装顺序」）：两档，默认留 60。 -->
    <TextBlock Classes="hint" x:Name="TimingHint"
               Text="按你游戏的帧率选 · 选错会漏音，不确定就留 60。" />

    <!-- ============ 倒计时 ============ -->
    <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="row-label" Text="倒计时" />
      <ComboBox Grid.Column="1" x:Name="CountdownCombo" HorizontalAlignment="Stretch" SelectedIndex="1" />
    </Grid>
    <TextBlock Classes="hint" x:Name="CountdownHint"
               Text="按下开始之后用它切到游戏窗口。倒计时结束才发第一个音，之后按任意键停；倒计时期间要取消只能按「急停」。" />

    <Border Classes="rule" />

    <!-- ============ 开始 / 急停 ============ -->
    <Button x:Name="StartButton" Classes="big big-start" Click="OnStart" IsEnabled="False">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="▶ 开始演奏" VerticalAlignment="Center" />
        <!-- 急停键写在按钮上：演奏前就该知道出事了按哪个键 -->
        <TextBlock Text="任意键急停" FontSize="11" FontWeight="Normal" Opacity="0.8"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Button x:Name="StopButton" Classes="big big-stop" Content="■ 急停"
            Click="OnStop" IsEnabled="False" />

    <!-- ============ 状态 ============ -->
    <!--
      这一行是「为什么没开始」的唯一通道：预检不放行时它说的是三种失败里具体哪一种、
      下一步去改什么（文案在 Format.PreflightRefusal，不在这个文件里）。

      这儿这一句是**还没曲子那一下**的（构造期的样子，见 PerformerWindow.axaml.cs 的构造器）：
      曲子一递进来就换成「就绪 · 轨名 · 共 N 个音」（ShowReady）。
      写的是「按开始之后窗口会自动最小化」—— 那是这个窗口自己的行为（51 号票），
      不是一条要用户去做的操作；「先打开一首 MIDI」在这儿是一句办不到的话（这一屏没有那条路）。
    -->
    <Border Classes="status">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="StatusDot" Classes="dot" Text="●" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="就绪 · 按开始之后窗口会自动最小化" />
      </StackPanel>
    </Border>

  </StackPanel>
</Window>
