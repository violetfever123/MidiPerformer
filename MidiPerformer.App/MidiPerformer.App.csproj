<Project Sdk="Microsoft.NET.Sdk">

  <!--
    最外层：Avalonia + Main。
    App.axaml.cs 的 OnFrameworkInitializationCompleted() 是全程序唯一 new 具体实现的地方，别处一律构造器注入。
    Main 第一件事是查内置自检的环境变量（MIDIPERFORMER_SELFTEST，见 SelfTest\PerformerSelfTest.cs）：
    走那条路时不建窗口、不注册热键、不碰按键与 MIDI 设备，跑完直接退出（tools/run-selftest.ps1 走的就是它）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MidiPerformer.App</RootNamespace>
    <AssemblyName>MidiPerformer</AssemblyName>
    <!-- 标题栏左上角与任务栏列表里的小图标，只在这两处用。由 tools\make-appicon.py 生成。 -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    发布形态：win-x64 / 自包含 / 单文件 / 裁剪。只在显式打开开关时才生效 ——
    MidiPerformer.Tests 引用了本工程，无条件写在 PropertyGroup 里会让普通 build 也变成 RID 专属
    （产物从 bin\Debug\net8.0\ 挪到 bin\Debug\net8.0\win-x64\，而且因为自包含，一次 build
    就是整个运行时跟着落盘）。

        pwsh tools/publish.ps1                                      ← 推荐
        dotnet publish MidiPerformer.App -c Release -p:MidiPerformerPublish=true

    交付物一律是单文件 exe：不带开关的 dotnet publish 产出的是非单文件、不裁剪的开发形态。
    DebugType=none —— 单文件 exe 之外不带 .pdb 伴生文件。

    下面几个开关关掉的是本程序用不到的能力，只是不给裁剪器留着：
      DebuggerSupport                       调试器
      EventSourceSupport                    ETW 事件源
      MetadataUpdaterSupport                热重载
      HttpActivityPropagationSupport        HttpClient 的 Activity 传播（本程序不联网）
      EnableUnsafeBinaryFormatterSerialization
      AutoreleasePoolSupport                macOS 专用，win-x64 上是空操作

    没有开的三个：
      TrimMode=full                         自检会红：System.Text.Json 报反序列化构造器的参数名被裁掉
      NullabilityInfoContextSupport=false   Avalonia 的绑定引擎要用 NullabilityInfoContext
      UseSystemResourceKeys=true            .NET 的异常文本会变成资源键，而曲库的 JSON 报错直接显示给用户
  -->
  <PropertyGroup Condition="'$(MidiPerformerPublish)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>

  <!--
    裁剪时钉住的程序集：这些程序集的类型与成员一个都不删。
      MidiPerformer          App 程序集（XAML 里 new 的控件、{Binding} 的目标属性只被反射用到）
      Avalonia 系列          绑定引擎与 XAML 运行时
      Melanchall.DryWetMidi  MIDI 读写大量用反射
    改这份名单要同时改 SelfTest\PerformerSelfTest.cs 里的 PinnedAssemblies（那边有一条对应的运行时断言）。
  -->
  <ItemGroup Condition="'$(MidiPerformerPublish)' == 'true'">
    <TrimmerRootAssembly Include="MidiPerformer" />
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Melanchall.DryWetMidi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MidiPerformer.Adapters\MidiPerformer.Adapters.csproj" />
    <ProjectReference Include="..\MidiPerformer.Core\MidiPerformer.Core.csproj" />
  </ItemGroup>

  <!--
    发布目录里只留一个 exe：DryWetMidi 带进来的 macOS / Linux 原生库（.dylib / .so）
    不是 RID 限定的资产，publish 时会一起复制到 win-x64 输出。
    tools/publish.ps1 里另有一道「目录里只有一个 exe」的检查兜底。
  -->
  <Target Name="RemoveForeignNativeLibsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.dylib' Or '%(Extension)' == '.so'" />
    </ItemGroup>
  </Target>

  <!-- 发布目录里同样不留 .pdb：本工程不产，但被引用的 Core / Adapters 会产，publish 时会被复制进来。 -->
  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
