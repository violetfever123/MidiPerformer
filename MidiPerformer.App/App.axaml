<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MidiPerformer.App.App"
             RequestedThemeVariant="Dark">

  <!-- 令牌住在这里，是 Application 级的资源；ThemeDictionaries 让明暗两套跟着 ActualThemeVariant 走。 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MidiPerformer/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent 留着：它提供控件模板、键盘导航、Popup 定位，我们只覆盖长相 -->
    <FluentTheme />
    <StyleInclude Source="avares://MidiPerformer/Styles/Controls.axaml" />
  </Application.Styles>

</Application>
